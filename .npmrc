# No package in the tree needs to run code at install time. The two that would —
# protobufjs's postinstall and @google/genai's preinstall no-op — leave a tree that
# imports, typechecks and passes its tests without them.
ignore-scripts=true

# Pins land in package.json without a ^ range; the host's types move between
# minor versions, so an install must never widen a version by itself.
save-exact=true
