# pi-diarize — copy to .env and fill in. Real values never go in this file.

# Deepgram API key. Create one in the Deepgram console (API Keys → Create a New Key).
# The variable names here are provider-agnostic except this one: the key names the service it
# belongs to, because changing providers replaces the key rather than repointing it.
DEEPGRAM_API_KEY=

# Speech-to-text model, sent with every request. Omitting the parameter entirely would make
# Deepgram fall back to `base`.
MODEL=nova-3

# BCP-47 language code, e.g. en, da, is. Default is en and it is sent with every request.
# The tool's `language` parameter overrides it for one file.
# Language detection is a separate feature (`detect_language`) and is not enabled.
LANGUAGE=en

# Whether the transcript labels speakers: true or false. Blank means true.
# `diarize_model` is one parameter doing two jobs: it names the diarizer and turns diarization on,
# so `true` sends `diarize_model=latest` and there is no false value to send. Off leaves the
# parameter out entirely, so turns become plain paragraphs with no `Speaker N:` prefix, the
# metadata block carries no speaker count or diarizer version, and `rename_speakers` has nothing to
# rewrite.
DIARIZE_OUTPUT=
