# Secrets — never commit. The extension reads no env file; these rules only guard against the
# files other tools leave lying around in a working directory.
.env
.env.*
*.pem
*.key
secrets.*

# Audio inputs and transcripts: may contain recorded speech, keep them out.
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.webm

# …except the committed test fixtures, which are chosen, verified and licensed
# in test/fixtures/README.md.
!test/fixtures/*.wav

# TypeScript / Node
node_modules/
dist/
build/
out/
*.tsbuildinfo
coverage/
*.log
npm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
